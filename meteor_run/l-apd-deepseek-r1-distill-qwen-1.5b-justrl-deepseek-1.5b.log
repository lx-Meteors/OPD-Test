[36m(TaskRunner pid=226398)[0m \[ 9b + 7 = k \cdot b + 7k \]
[36m(TaskRunner pid=226398)[0m \[ 9b - kb = 7k - 7 \]
[36m(TaskRunner pid=226398)[0m \[ b(9 - k) = 7(k - 1) \]
[36m(TaskRunner pid=226398)[0m \[ b = \frac{7(k - 1)}{9 - k} \]
