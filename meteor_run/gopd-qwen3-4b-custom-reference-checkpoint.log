[36m(TaskRunner pid=439121)[0m 
[36m(TaskRunner pid=439121)[0m Divide through by 2:
[36m(TaskRunner pid=439121)[0m 
[36m(TaskRunner pid=439121)[0m $$
[36m(TaskRunner pid=439121)[0m 4s^2 + 8s - 45 = 0
[36m(TaskRunner pid=439121)[0m $$
