[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 9s = (-1.6)s(s + 2) + 9(s + 2)
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 9s = -1.6s^2 - 3.2s + 9s + 18
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 9s = -1.6s^2 - 3.2s + 9s + 18
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m Now collect all terms on one side:
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 1.6s^2 + 12.2s - 18 = 0
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m Multiply through by 10 to eliminate decimals:
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 16s^2 + 122s - 180 = 0
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m Solve this quadratic equation using the quadratic formula:
[36m(TaskRunner pid=39871)[0m 
[36m(TaskRunner pid=39871)[0m $$
[36m(TaskRunner pid=39871)[0m s = \frac{-122 \pm \sqrt{122^2 - 4 \cdot 16 \cdot (-180)}}{2 \cdot 16}
