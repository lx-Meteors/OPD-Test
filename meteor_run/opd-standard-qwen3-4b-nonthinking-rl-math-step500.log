[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 9s = (-1.6)s(s + 2) + 9(s + 2)
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 9s = -1.6s^2 - 3.2s + 9s + 18
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 9s = -1.6s^2 - 3.2s + 9s + 18
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m Now collect all terms on one side:
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 1.6s^2 + 12.2s - 18 = 0
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m Multiply through by 10 to eliminate decimals:
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 16s^2 + 122s - 180 = 0
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m Solve this quadratic equation using the quadratic formula:
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m s = \frac{-122 \pm \sqrt{122^2 - 4 \cdot 16 \cdot (-180)}}{2 \cdot 16}
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m First compute discriminant:
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 122^2 = 14884
[36m(TaskRunner pid=311193)[0m \quad 4 \cdot 16 \cdot 180 = 11520
[36m(TaskRunner pid=311193)[0m \quad \text{Discriminant} = 14884 + 11520 = 26404
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m \sqrt{26404} = 162.5
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m So:
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m s = \frac{-122 \pm 162.5}{32}
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m Try both roots:
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m - $ s = \frac{-122 + 162.5}{32} = \frac{40.5}{32} = 1.265625 $ km/h
[36m(TaskRunner pid=311193)[0m - $ s = \frac{-122 - 162.5}{32} = \text{negative value, invalid} $
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m So $ s \approx 1.265625 $ km/h
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m ---
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m ### Step 5: Find time when walking at speed $ s + \frac{1}{2} $
[36m(TaskRunner pid=311193)[0m 
[36m(TaskRunner pid=311193)[0m $$
[36m(TaskRunner pid=311193)[0m s + \frac{1}{2} = 1.265625 + 0.5 = 1.765625 \text{ km/h}
